# Reconstruir gosu con el compilador corregido, sin agregar Go al runtime.
FROM golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS gosu-build
WORKDIR /src
RUN wget -q https://codeload.github.com/tianon/gosu/tar.gz/6456aaa0f3c854d199d0f037f068eb97515b7513 -O /tmp/gosu.tar.gz \
    && echo '33d7537d588ea49458b9509bcf4554bdf5ceacc66da71e5caa1058ea3b689c3b  /tmp/gosu.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/gosu.tar.gz --strip-components=1 \
    && rm /tmp/gosu.tar.gz
COPY docker/gosu/go.mod docker/gosu/go.sum ./
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/gosu .

FROM mysql:8.4@sha256:6ea90827b1100f8f2ae306a539f86d2c264a26ed435a2a9f75551dd5c3aeb242 AS mysql-with-shell

# Oracle corrige tres avisos de gawk sin cambiar la versión del servidor MySQL.
RUN microdnf install -y gawk-5.1.0-6.el9_8.1 \
        openssl-3.5.8-2.0.1.el9_8 openssl-libs-3.5.8-2.0.1.el9_8 \
    && test "$(rpm -q --qf '%{VERSION}-%{RELEASE}' gawk)" = '5.1.0-6.el9_8.1' \
    && microdnf clean all

FROM mysql-with-shell

# La aplicación usa PDO y los clientes SQL; Shell y su Python no son necesarios.
RUN set -eu; \
    rpm -q mysql-shell; \
    rpm -e --test mysql-shell; \
    for tool in mysqld mysql mysqladmin mysqldump; do \
        command -v "$tool"; \
    done; \
    sha256sum /usr/sbin/mysqld /usr/bin/mysql /usr/bin/mysqladmin /usr/bin/mysqldump /usr/local/bin/gosu /usr/local/bin/docker-entrypoint.sh > /tmp/eventify-mysql-tools.sha256; \
    rpm -e mysql-shell; \
    if rpm -q mysql-shell; then exit 1; fi; \
    if [ -d /usr/lib/mysqlsh ]; then \
        find /usr/lib/mysqlsh -exec sh -ec 'for path do if rpm -qf "$path" >/dev/null 2>&1; then echo "La carpeta conserva archivos de otro paquete; construcción rechazada." >&2; exit 1; fi; done' sh {} +; \
        rm -rf -- /usr/lib/mysqlsh; \
    fi; \
    test ! -e /usr/lib/mysqlsh; \
    test ! -e /usr/bin/mysqlsh; \
    sha256sum -c /tmp/eventify-mysql-tools.sha256; \
    mysqld --version; \
    mysql --version; \
    mysqldump --version; \
    rm /tmp/eventify-mysql-tools.sha256

# Mantener la misma versión de gosu y su función de bajar privilegios.
COPY --from=gosu-build /out/gosu /usr/local/bin/gosu
COPY docker/gosu/LICENSE docker/gosu/NOTICE /usr/share/licenses/eventify-gosu/
RUN gosu --version \
    && test "$(gosu mysql id -u)" = "$(id -u mysql)" \
    && test "$(gosu mysql id -g)" = "$(id -g mysql)"
